{
  "name": "metrora-desktop",
  "private": true,
  "version": "1.0.0-rc.11",
  "description": "Metrora Desktop — local-first AI usage intelligence",
  "main": "dist/electron/bootstrap.js",
  "scripts": {
    "brand:assets": "node ../scripts/generate-brand-assets.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run brand:assets && npm run build:electron && npm run build:renderer",
    "dev": "npm run stage-cli && npm run build:electron && concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http-get://127.0.0.1:5173/ && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "test": "vitest run",
    "test:safe-storage": "electron scripts/probe-safe-storage.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "stage-cli": "npm --prefix .. run build:cli && node scripts/stage-cli.mjs",
    "package": "npm run stage-cli && npm run build && electron-builder --mac",
    "package:arm64": "npm run stage-cli && npm run build && electron-builder --mac --arm64",
    "package:x64": "npm run stage-cli && npm run build && electron-builder --mac --x64",
    "package:win": "npm run stage-cli && npm run build && electron-builder --win",
    "package:store": "npm run stage-cli && npm run build && electron-builder --win appx --x64 --publish never",
    "package:linux": "npm run stage-cli && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-bash-local": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-bash-sandbox": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-code-runtime": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-commands": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-compaction": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-compaction-basic": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-fs": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-fs-local": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-fs-sandbox": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-jobs": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-jobs-local": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm-retry": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-mcp-client": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-output-retention": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-sandbox": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-sandbox-local": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-shell": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-shell-env": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-spill": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-spill-local": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-spill-policy": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-subprocess-local": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-terminal": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-terminal-bash": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-token-meter": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tool-bash": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tool-fs": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tool-fs-search": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tool-jobs": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tool-subagent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tool-terminal": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tool-web": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-util-crypto": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-util-time": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-util-values": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-web": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-web-fetch-http": "0.1.2-alpha.5",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@xmldom/xmldom": "^0.8.13",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "eu.metrora.desktop",
    "productName": "Metrora",
    "copyright": "Copyright © 2026 Metrora contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "afterPack": "./scripts/after-pack.cjs",
    "appxManifestCreated": "./scripts/appx-manifest-created.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Metrora reads local AI coding tool session logs to calculate token usage and cost. Prompt and response bodies are not exported by default.",
        "NSDesktopFolderUsageDescription": "Metrora reads local AI coding tool session logs to calculate token usage and cost. Prompt and response bodies are not exported by default.",
        "NSDownloadsFolderUsageDescription": "Metrora reads local AI coding tool session logs to calculate token usage and cost. Prompt and response bodies are not exported by default."
      }
    },
    "dmg": {},
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Metrora-Setup-${version}.${ext}"
    },
    "appx": {
      "applicationId": "eu.metrora.desktop",
      "identityName": "Vensent.Metrora",
      "publisher": "CN=BC955F81-5099-4C27-A7A6-FF611BAACC3F",
      "publisherDisplayName": "Vensent",
      "displayName": "Metrora",
      "artifactName": "Metrora-${version}-Windows-Store-${arch}.${ext}",
      "capabilities": [
        "runFullTrust"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Vensent (https://metrora.eu)",
      "executableName": "metrora"
    },
    "buildVersion": "1.0.0.11"
  },
  "homepage": "https://metrora.eu",
  "publisher": "Vensent",
  "author": "Vensent (https://metrora.eu)",
  "engines": {
    "node": ">=22.19.0"
  }
}
